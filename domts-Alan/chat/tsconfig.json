{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "outDir": "./dist",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "lib": [
            "DOM",
            "ES2020"
        ]
    },
    "include": [
        "./**/*.ts"
    ],
    "exclude": [
        "dist"
    ]
}